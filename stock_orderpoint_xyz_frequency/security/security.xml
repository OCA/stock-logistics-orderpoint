<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="xyz_classification_level_rule" model="ir.rule">
        <field name="name">XYZ Classification Level multi-company</field>
        <field name="model_id" ref="model_xyz_classification_level" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="xyz_classification_product_level_rule" model="ir.rule">
        <field name="name">XYZ Classification Product Level multi-company</field>
        <field name="model_id" ref="model_xyz_classification_product_level" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
