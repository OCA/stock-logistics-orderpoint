<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.xyz.classification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="XYZ Classification"
                    name="xyz_classification"
                    invisible="not is_storable"
                >
                    <field
                        name="xyz_classification_product_level_ids"
                        readonly="product_variant_count &gt; 1"
                    >
                        <list editable="bottom">
                            <field name="allowed_level_ids" column_invisible="1" />
                            <field
                                name="level_id"
                                domain="[('id', 'in', allowed_level_ids)]"
                            />
                            <field
                                name="last_replenishment_date"
                                string="Last run"
                                width="130"
                            />
                            <field
                                name="days_to_next_replenishment"
                                string="Days left"
                                width="110"
                            />
                            <field
                                name="next_replenishment_date"
                                string="Next run"
                                width="130"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
