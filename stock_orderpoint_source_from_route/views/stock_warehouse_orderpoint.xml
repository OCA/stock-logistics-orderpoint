<odoo>
    <record model="ir.ui.view" id="stock_warehouse_orderpoint_form_view">
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field
                    name="location_src_id"
                    groups="stock.group_stock_multi_locations"
                />
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_tree_editable" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.editable</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <field name="route_id" position="after">
                <field
                    name="location_src_id"
                    groups="stock.group_stock_multi_locations"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
