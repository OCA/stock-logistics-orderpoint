<templates xml:space="preserve">
    <t t-inherit="stock.replenishmentGraph" t-inherit-mode="extension">
        <xpath expr="//span[@t-out='dailyDemand']/parent::span" position="after">
            <span t-if="safetyStockMethod != 'manual'" class="pt-2">
                Standard Deviation (σ): <span t-out="standardDeviation" /> <span
                t-out="productUomName"
            />/day
            </span>
        </xpath>
    </t>
</templates>
