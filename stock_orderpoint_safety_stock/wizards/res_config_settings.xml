<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='schedule_info']//field[@name='horizon_days']/parent::setting"
                position="after"
            >
                <setting
                    company_dependent="1"
                    help="Define the rolling window for the historical analysis to compute the orderpoint's average daily demand and safety stock."
                >
                    <field name="demand_history_days" class="oe_inline" />
                    <span> days</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
